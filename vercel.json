{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "ana_sayfa/**",
          "saha_listeleme/**",
          "saha_detay/**",
          "rezervasyon/**",
          "kullan_c_paneli/**",
          "admin_paneli/**",
          "frontend/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/backend/server.js" }
  ]
}
